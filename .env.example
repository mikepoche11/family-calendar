# Copy to .env and fill in. .env is ignored by git.

# The shared Google calendar's ID (Google Calendar > Settings > Poche Family > Integrate calendar > Calendar ID)
GOOGLE_CALENDAR_ID=
# Path inside the container; put the key file at ./secrets/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/google-service-account.json

TIMEZONE=America/Chicago

# Weather location (decimal degrees). Leave blank to hide weather.
LATITUDE=
LONGITUDE=
TEMPERATURE_UNIT=fahrenheit

# Family members and colours, used only on first start (edit later through the API).
# Events are matched to a person by title: "Mike: Dentist" or "[Mike] Dentist".
PEOPLE=Mike:#2563eb,Mom:#16a34a,Kid:#db2777

# How often to pull from Google, in seconds
SYNC_INTERVAL_SECONDS=300
