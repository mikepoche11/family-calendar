# Copy to .env and fill in. .env is ignored by git.

# The shared Google calendar's ID (Google Calendar > Settings > Poche Family > Integrate calendar > Calendar ID)
GOOGLE_CALENDAR_ID=
# Path inside the container; put the key file at ./secrets/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/google-service-account.json

TIMEZONE=America/Chicago

# Weather location (decimal degrees; this is ZIP 70774, St. Amant LA). Leave blank to hide weather.
LATITUDE=30.2274
LONGITUDE=-90.7882
TEMPERATURE_UNIT=fahrenheit

# Family members and colours, used only on first start (edit later through the API).
# Events are matched to a person by title: "Mike: Dentist" or "[Mike] Dentist".
PEOPLE=Mike:#93c5fd,Bridget:#86efac,Eppie Marie:#f9a8d4,Jordyn:#c4b5fd,Aaron:#fdba74

# How often to pull from Google, in seconds
SYNC_INTERVAL_SECONDS=300

# --- Photo screensaver (optional, see docs/photos-setup.md) ---
# OAuth "Web application" client for the Google Photos Picker
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Address of this app as seen from the screen you'll sign in on (redirect URI = PUBLIC_URL/api/photos/auth/callback)
PUBLIC_URL=http://localhost:8000
# Minutes untouched before the slideshow starts, and seconds per photo
SCREENSAVER_MINUTES=10
SLIDE_SECONDS=15
